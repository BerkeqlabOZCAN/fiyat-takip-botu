# bunu .env olarak kopyala

API_HOST=0.0.0.0
API_PORT=8787
# bos birakirsan token sorulmaz
API_TOKEN=

CHECK_INTERVAL_MINUTES=10
ENABLED_SITES=vatan,itopya,incehesap,n11,hepsiburada,gaminggen,trendyol,amazon

HTTP_TIMEOUT=25
MAX_CONCURRENT=4
RETRY_BROADER=1
