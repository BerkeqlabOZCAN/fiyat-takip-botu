# trendyol ve amazon icin
USE_PLAYWRIGHT=1
PW_HEADLESS=1
PW_TIMEOUT_MS=35000
PW_MAX_CONCURRENT=2
PW_DEBUG_DUMP=0

# 0 = sinir yok
MIN_PRICE=0
MAX_PRICE=0

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_COMMANDS=1
BACKEND_TELEGRAM=1

DB_PATH=data/tracker.db
LOG_LEVEL=INFO
